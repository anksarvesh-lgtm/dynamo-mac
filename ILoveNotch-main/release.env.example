# Copy to release.env (git-ignored) for scripts/release.sh. Never commit the real file or the key.

# App Store Connect team API key, for notarization (and App Store uploads).
ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# The Apple Developer team that signs releases.
TEAM_ID=XXXXXXXXXX
