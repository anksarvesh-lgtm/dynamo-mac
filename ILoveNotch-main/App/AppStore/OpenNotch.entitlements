<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Store edition runs in the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Calendar and Reminders (EventKit). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- The Mirror tab. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- System audio for the media waveform. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- A notes folder the user picks, such as one in iCloud Drive. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Shelf files dropped earlier stay reachable after relaunch. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Media's controls, through the scripting access groups Music and Spotify publish: playback
	     (play, skip, seek, shuffle, repeat) and reading the track (Music's up next and cover, a
	     Spotify track's link to play it again). macOS asks once per app (Automation). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.scripting-targets</key>
	<dict>
		<key>com.apple.Music</key>
		<array>
			<string>com.apple.Music.playback</string>
			<string>com.apple.Music.library.read</string>
		</array>
		<key>com.spotify.client</key>
		<array>
			<string>com.spotify.playback</string>
			<string>com.spotify.library</string>
		</array>
	</dict>
</dict>
</plist>
