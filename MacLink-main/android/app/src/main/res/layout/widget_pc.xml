<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Header Row: PC Name + Latency/Volume subtitle + Online Badge + Wake button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pc_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_pc_no_pc"
                android:textColor="#FAF6EE"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pc_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_pc_tap_to_pair"
                android:textColor="#C4BDB0"
                android:textSize="11.5sp"
                android:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_pc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_pill_offline"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_pc_offline"
            android:textColor="#D5CFC2"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_button"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_pc_wake"
            android:textColor="#F4B841"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Live PC Media Strip (shown when PC is playing/paused media) -->
    <LinearLayout
        android:id="@+id/widget_media_row"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_media_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FAF6EE"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_btn_media_play"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/media_play"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="#F4B841" />

        <ImageView
            android:id="@+id/widget_btn_media_next"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/media_next"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            android:tint="#FAF6EE" />
    </LinearLayout>

    <!-- 4 Quick Action Bento Pills: Send Files, Clipboard, Ring PC, Lock PC -->
    <LinearLayout
        android:id="@+id/widget_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_send_files"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/action_send_files"
            android:textColor="#FAF6EE"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_send_clip"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/widget_pc_send_clip"
            android:textColor="#FAF6EE"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_ring"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/widget_pc_ring"
            android:textColor="#FAF6EE"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_lock"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/widget_pc_lock"
            android:textColor="#FAF6EE"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
